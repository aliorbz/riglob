# RiGlob - Local Environment Configuration Example
# Copy this file and rename it to ".env.local" in the same directory, then fill in your actual credentials.

# Your Supabase Project API Connection details (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-api-key-here
